<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="이번 달 지출" android:textSize="12sp" android:textColor="#5F5C55" />
        <TextView android:id="@+id/w_spent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-" android:textSize="22sp" android:textStyle="bold" android:textColor="#1C1B19" android:maxLines="1" />
        <ProgressBar android:id="@+id/w_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
            android:max="100" android:progress="0" android:progressTint="#2F4B7C" android:progressBackgroundTint="#E7E4DC" />
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="앱을 한 번 열면 표시돼요" android:textSize="12sp" android:textColor="#5F5C55" android:maxLines="1" />
    </LinearLayout>

    <TextView android:id="@+id/w_mic"
        android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="12dp"
        android:background="@drawable/widget_mic" android:gravity="center"
        android:text="🎤" android:textSize="22sp" android:contentDescription="말로 입력" />
</LinearLayout>
